  class ContentGeneratorBot: 

    def __init__(self, client):         self.client = client 
        self.model = 'gemini-2.5-flash' 
 
        # System prompts configuring distinct agent roles         self.prompts = { 
            "email": ( 
                "You are an expert professional communicator and business writer. "                 "Your goal is to write clear, concise, persuasive, and appropriately toned emails. " 
                "Always include a subject line, respect standard business email formats, and " 
                "ensure the call to action is distinct and actionable."             ), 
            "report": ( 
                "You are an expert business and technical analyst. " 
                "Your goal is to write well-structured, professional reports. "                 "Use markdown headers, executive summaries, key findings, bullet points, and data-driven " 
                "sections. Maintain an objective, authoritative, and analytical tone."             ), 
            "technical": ( 
                "You are an elite technical educator and developer advocate. "                 "Your goal is to explain highly complex technical, mathematical, or architectural concepts " 
                "in an accessible and engaging manner. Use analogies, clear stepby-step breakdowns, " 
                "and well-commented code snippets where appropriate." 
            ) 
        } 
 
    def generate(self, mode: str, prompt_input: str, tone: str = "Professional") -> str: 
        if mode not in self.prompts: 
            return f"Error: Mode '{mode}' is invalid. Please select from: 
{list(self.prompts.keys())}" 
 
        # Fallback Mock Service for demonstration when no API Client is connected         if self.client is None: 
            return self._mock_generate(mode, prompt_input, tone) 
 
        system_instruction = self.prompts[mode] 
        user_content = f"Task: Generate content based on the following input.\nTone: {tone}\nInput description: {prompt_input}" 
         try: 
            response = self.client.models.generate_content(                 model=self.model,                 contents=user_content, 
                config=types.GenerateContentConfig(                     system_instruction=system_instruction,                     temperature=0.7, 
                ) 
            ) 

            return response.text         except Exception as e: 
            print(f"API failed with error: {e}. Falling back to simulation response.") 
            return self._mock_generate(mode, prompt_input, tone) 
